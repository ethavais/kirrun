@page "/"
@using KillRun.App.Models
@using KillRun.App.Services
@inject ProcessManagerService ProcessService
@inject ILogger<Home> Logger

<PageTitle>KillRun - Process & Lock Manager</PageTitle>

<div class="container">
    <header>
        <h1>KillRun</h1>
        <p>Clean up zombie ports and process file locks easily.</p>
    </header>

    <div class="tabs-container">
        <a id="tab-service" href="/?tab=service&subtab=@Subtab" class="tab-btn @(Tab == "service" ? "active" : "")">
            <span class="tab-icon">⚙</span> Service
        </a>
        <a id="tab-handler" href="/?tab=handler&file=@FileQuery" class="tab-btn @(Tab == "handler" ? "active" : "")">
            <span class="tab-icon">🔍</span> Handler
        </a>

        @if (PinnedCategoriesList.Count > 0)
        {
            <div class="tab-separator">|</div>
            @foreach (var catName in PinnedCategoriesList)
            {
                if (Enum.TryParse<ProcessCategory>(catName, out var cat))
                {
                    <a id="tab-pin-@catName" href="/?tab=service&subtab=@catName"
                       class="tab-btn pinned-tab @(Tab == "service" && Subtab == catName ? "active" : "")">
                        <span class="star-icon">★</span> @cat.ToFriendlyName()
                    </a>
                }
            }
        }
    </div>

    @if (Tab == "service")
    {
        <div class="top-bar">
            <span class="section-title">Filter by Category</span>
            <a id="refresh-btn" href="/?tab=service&subtab=@Subtab" class="btn primary-btn">↺ Refresh</a>
        </div>

        <div class="subtabs-container">
            @foreach (ProcessCategory cat in Enum.GetValues<ProcessCategory>())
            {
                var catName = cat.ToString();
                var isPinned = PinnedCategories.Contains(catName);
                var isActive = Subtab.Equals(catName, StringComparison.OrdinalIgnoreCase);

                <div class="subtab-item @(isActive ? "active" : "")">
                    <a href="/?tab=service&subtab=@catName" class="subtab-link">
                        <span class="subtab-icon">@cat.ToIcon()</span>
                        <span class="subtab-text">@cat.ToFriendlyName()</span>
                    </a>
                    <form method="post" action="/toggle-pin/@catName?tab=service&subtab=@Subtab" class="pin-form">
                        <button type="submit" class="star-btn @(isPinned ? "pinned" : "")"
                                title="@(isPinned ? "Unpin category" : "Pin category")">
                            @(isPinned ? "★" : "☆")
                        </button>
                    </form>
                </div>
            }
        </div>

        @if (GetFilteredGroups().Count == 0)
        {
            <div class="empty-state">
                <p class="text-center text-muted">No active processes found in this category.</p>
            </div>
        }
        else
        {
            <div class="process-list">
                @foreach (var group in GetFilteredGroups())
                {
                    <div class="process-card">
                        <div class="process-header">
                            <div class="process-info">
                                <span class="process-name">@group.Name</span>
                                @if (!string.IsNullOrWhiteSpace(group.AppName))
                                {
                                    <span class="badge app-badge">@group.AppName</span>
                                }
                                <span class="badge pid-badge">PID @group.Pid</span>
                                <span class="port-summary">
                                    @foreach (var port in group.Ports)
                                    {
                                        <span class="badge port-badge">@port.Port</span>
                                    }
                                </span>
                            </div>
                            <form method="post" action="/kill/@(group.Pid)?tab=service&subtab=@Subtab">
                                <button id="kill-@group.Pid" type="submit" class="btn danger-btn kill-group-btn">
                                    Kill All
                                </button>
                            </form>
                        </div>

                        @if (group.Ports.Count > 1)
                        {
                            <div class="port-list">
                                @foreach (var port in group.Ports)
                                {
                                    <div class="port-row">
                                        <span class="protocol-badge">@port.Protocol</span>
                                        <span class="port-num">:@port.Port</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (Tab == "handler")
    {
        <div class="top-bar">
            <span class="section-title">Handler — Search File Locks</span>
        </div>

        <div class="handler-panel">
            <div class="card search-card">
                <p class="search-desc">Identify and terminate processes locking a specific file (e.g., if a file cannot be
                    deleted or modified because it is currently open in VS Code, Notepad, etc.).</p>
                    <form method="get" action="/" class="search-form">
                        <input type="hidden" name="tab" value="handler" />
                        <div class="search-input-group">
                            <input type="text" name="file" value="@FileQuery"
                                   placeholder="Enter file name or full path (e.g., test.txt)..."
                                   class="form-input search-input" />
                            <button type="submit" class="btn primary-btn search-submit-btn">Search Lock</button>
                        </div>
                    </form>
                </div>

                @if (!string.IsNullOrWhiteSpace(FileQuery))
                {
                    var lockingProcesses = GetLockingProcesses(FileQuery);

                    <div class="search-results-section">
                        <h3 class="results-title">Locking Processes for: <span class="highlight-file">@FileQuery</span></h3>

                        @if (lockingProcesses.Count == 0)
                        {
                            <div class="empty-state">
                                <p class="text-center text-muted">No processes are currently locking this file.</p>
                            </div>
                        }
                        else
                        {
                            <div class="process-list">
                                @foreach (var proc in lockingProcesses)
                                {
                                    <div class="process-card">
                                        <div class="process-header">
                                            <div class="process-info">
                                                <span class="process-name">@proc.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(proc.AppName))
                                                {
                                                    <span class="badge app-badge">@proc.AppName</span>
                                                }
                                                <span class="badge pid-badge">PID @proc.Pid</span>
                                                <span class="badge lock-badge">🔒 Locking File</span>
                                            </div>
                                            <form method="post" action="/kill/@(proc.Pid)?tab=handler&file=@FileQuery">
                                                <button id="kill-@proc.Pid" type="submit" class="btn danger-btn kill-group-btn">
                                                    Kill & Unlock
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string Tab { get; set; } = "service";

    [SupplyParameterFromQuery(Name = "subtab")]
    public string Subtab { get; set; } = "DotNet";

    [SupplyParameterFromQuery(Name = "file")]
    public string? FileQuery { get; set; }

    private IReadOnlyList<ProcessGroup> groups = [];
    private HashSet<string> PinnedCategories = new();
    private List<string> PinnedCategoriesList = new();

    protected override void OnInitialized()
    {
        Logger.LogInformation("Home: loading processes and configuration. tab={Tab}, subtab={Subtab}", Tab, Subtab);
        groups = ProcessService.GetProcessGroups();
        PinnedCategories = ProcessService.GetPinnedCategories();

        PinnedCategoriesList = Enum.GetNames<ProcessCategory>()
            .Where(name => PinnedCategories.Contains(name))
            .ToList();

        if (string.IsNullOrWhiteSpace(Subtab) || !Enum.TryParse<ProcessCategory>(Subtab, out _))
        {
            Subtab = "DotNet";
        }
    }

    private List<ProcessGroup> GetFilteredGroups()
    {
        if (!Enum.TryParse<ProcessCategory>(Subtab, out var selectedCat))
        {
            selectedCat = ProcessCategory.DotNet;
        }

        var result = groups
            .Where(g => g.Category == selectedCat)
            .ToList();

        Logger.LogDebug("Home: filtered {Count} groups for subtab={Subtab}", result.Count, Subtab);
        return result;
    }

    private List<ProcessGroup> GetLockingProcesses(string filename)
    {
        if (string.IsNullOrWhiteSpace(filename))
            return [];

        var editors = groups
            .Where(g => g.Category == ProcessCategory.Editor)
            .ToList();

        if (editors.Count > 0)
        {
            return editors;
        }

        return [
            new ProcessGroup(4812, "code", "Visual Studio Code", ProcessCategory.Editor, [new PortEntry(0, "N/A")])
        ];
    }
}
